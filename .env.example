# Supabase (local dev: run `npx supabase start` and copy the printed values)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Used to build OAuth redirect URLs when the `origin` header is unavailable
# (e.g. in some server contexts). Defaults to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google OAuth client (Google Cloud Console -> APIs & Services -> Credentials).
# Authorized redirect URI: http://127.0.0.1:54321/auth/v1/callback (local)
# Scope requested: https://www.googleapis.com/auth/calendar.readonly (read-only)
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
